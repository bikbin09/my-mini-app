<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Video ViralX Zone</title>
    <!-- Telegram WebApp SDK -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #0b0f19;
            --card-bg: #151c2c;
            --accent-orange: #ff6b00;
            --accent-blue: #3b82f6;
            --accent-purple: #8b5cf6;
            --text-main: #ffffff;
            --text-sub: #94a3b8;
            --border-color: #1e293b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Hind Siliguri', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            padding-bottom: 90px;
            overflow-x: hidden;
        }

        /* Top Ticker Bar */
        .ticker-wrap {
            background: linear-gradient(90deg, #dc2626, #b91c1c);
            color: white;
            padding: 6px 10px;
            font-size: 13px;
            font-weight: 600;
            overflow: hidden;
            white-space: nowrap;
            box-shadow: 0 2px 10px rgba(220, 38, 38, 0.3);
        }
        .ticker-text {
            display: inline-block;
            animation: ticker 18s linear infinite;
        }
        @keyframes ticker {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }

        /* Header */
        header {
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(11, 15, 25, 0.95);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid var(--border-color);
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .logo-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #ff6b00, #ff8800);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: white;
            box-shadow: 0 0 12px rgba(255, 107, 0, 0.5);
        }
        .logo-text {
            font-size: 20px;
            font-weight: 700;
            background: linear-gradient(90deg, #ffffff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .badge-4k {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 3px 8px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            color: #38bdf8;
        }

        /* Hero Banner */
        .hero-banner {
            margin: 15px;
            height: 160px;
            border-radius: 16px;
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.8)), url('https://picsum.photos/800/400?random=99') center/cover;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 15px;
            position: relative;
            box-shadow: 0 8px 20px rgba(0,0,0,0.4);
            border: 1px solid var(--border-color);
        }
        .hero-play-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 55px;
            height: 55px;
            background: rgba(255, 107, 0, 0.9);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: white;
            box-shadow: 0 0 20px rgba(255, 107, 0, 0.6);
            cursor: pointer;
        }
        .hero-title {
            font-size: 18px;
            font-weight: 700;
            color: white;
            text-shadow: 0 2px 4px rgba(0,0,0,0.8);
        }

        /* Search Bar */
        .search-box {
            margin: 0 15px 15px 15px;
            position: relative;
        }
        .search-input {
            width: 100%;
            padding: 12px 45px 12px 15px;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 25px;
            color: white;
            font-size: 14px;
            outline: none;
        }
        .search-btn {
            position: absolute;
            right: 5px;
            top: 50%;
            transform: translateY(-50%);
            width: 35px;
            height: 35px;
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
            border: none;
            border-radius: 50%;
            color: white;
            cursor: pointer;
        }

        /* Categories Scroll */
        .categories-container {
            display: flex;
            gap: 10px;
            padding: 0 15px 15px 15px;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .categories-container::-webkit-scrollbar {
            display: none;
        }
        .cat-chip {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            white-space: nowrap;
            color: var(--text-sub);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .cat-chip.active {
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
            color: white;
            border: none;
            font-weight: 600;
        }

        /* Pagination Numbers Bar */
        .pagination-bar {
            margin: 0 15px 20px 15px;
            padding: 12px;
            background: var(--card-bg);
            border-radius: 30px;
            border: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            overflow-x: auto;
            gap: 8px;
            scrollbar-width: none;
        }
        .pagination-bar::-webkit-scrollbar {
            display: none;
        }
        .page-num {
            min-width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-sub);
            background: rgba(255, 255, 255, 0.05);
            cursor: pointer;
        }
        .page-num.active {
            background: linear-gradient(135deg, var(--accent-orange), #ff8800);
            color: white;
            box-shadow: 0 0 10px rgba(255, 107, 0, 0.5);
        }

        /* Section Title */
        .section-header {
            padding: 0 15px 12px 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .section-title {
            font-size: 16px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Video List / Grid */
        .video-grid {
            padding: 0 15px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        .video-card {
            background: var(--card-bg);
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            position: relative;
        }
        .thumb-wrapper {
            position: relative;
            width: 100%;
            height: 200px;
            background-color: #000;
            cursor: pointer;
        }
        .thumb-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 1fr 1fr;
            height: 100%;
            gap: 2px;
        }
        .thumb-grid img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .video-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: linear-gradient(135deg, var(--accent-orange), #ff8800);
            color: white;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 6px;
            z-index: 2;
        }
        .play-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 50px;
            height: 50px;
            background: rgba(220, 38, 38, 0.9);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            box-shadow: 0 0 15px rgba(220, 38, 38, 0.8);
            z-index: 2;
        }
        .card-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            padding: 12px;
            background: rgba(15, 23, 42, 0.6);
        }
        .btn-action {
            padding: 10px;
            border-radius: 10px;
            border: none;
            font-weight: 600;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            cursor: pointer;
            color: white;
        }
        .btn-play {
            background: linear-gradient(135deg, #2563eb, #3b82f6);
        }
        .btn-download {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        /* Floating Join Button */
        .floating-join-btn {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #0088cc, #00a8ff);
            color: white;
            padding: 12px 28px;
            border-radius: 30px;
            font-weight: 700;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 25px rgba(0, 136, 204, 0.6);
            z-index: 999;
            text-decoration: none;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% { transform: translateX(-50%) scale(1); }
            50% { transform: translateX(-50%) scale(1.05); }
            100% { transform: translateX(-50%) scale(1); }
        }

        /* Video Modal Player */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            padding: 15px;
        }
        .modal-content {
            width: 100%;
            max-width: 500px;
            background: var(--card-bg);
            border-radius: 16px;
            overflow: hidden;
            position: relative;
        }
        .close-modal {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 24px;
            color: white;
            cursor: pointer;
            z-index: 10;
        }
        .video-container {
            width: 100%;
            height: 250px;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Toast Notice */
        .toast {
            position: fixed;
            top: 70px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(16, 185, 129, 0.9);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: none;
            z-index: 1000;
        }
    </style>
</head>
<body>

    <!-- Notification Toast -->
    <div id="toast" class="toast"><i class="fa-solid fa-circle-check"></i> অ্যাড লিংক খোলার চেষ্টা করা হচ্ছে...</div>

    <!-- Top Announcement Ticker -->
    <div class="ticker-wrap">
        <div class="ticker-text">
            🔥 প্রতিদিন নতুন নতুন ট্রেন্ডিং ভিডিও ফ্রিতে দেখুন এবং ডাউনলোড করুন! পছন্দমতো ভিডিও আনলক করতে নিচের বাটনগুলোতে চাপ দিন।
        </div>
    </div>

    <!-- Header Section -->
    <header>
        <div class="logo">
            <div class="logo-icon"><i class="fa-solid fa-play"></i></div>
            <div class="logo-text">Video ViralX Zone</div>
        </div>
        <div class="badge-4k">4K ULTRA HD</div>
    </header>

    <!-- Main Banner -->
    <div class="hero-banner" onclick="handleAdClick('adsterra')">
        <div class="hero-play-btn"><i class="fa-solid fa-play"></i></div>
        <div class="hero-title">🎬 প্রিমিয়ার নাইট - আজকের সেরা ভিডিও ভাইরাস প্যাক</div>
    </div>

    <!-- Search Bar -->
    <div class="search-box">
        <input type="text" class="search-input" placeholder="ভিডিও সার্চ করুন...">
        <button class="search-btn" onclick="handleAdClick('monetag')"><i class="fa-solid fa-magnifying-glass"></i></button>
    </div>

    <!-- Categories horizontal list -->
    <div class="categories-container">
        <div class="cat-chip active" onclick="filterCat(this)"><i class="fa-solid fa-globe"></i> সবকটা</div>
        <div class="cat-chip" onclick="filterCat(this)"><i class="fa-solid fa-fire"></i> ট্রেন্ডিং</div>
        <div class="cat-chip" onclick="filterCat(this)"><i class="fa-solid fa-film"></i> রাশিয়ান</div>
        <div class="cat-chip" onclick="filterCat(this)"><i class="fa-solid fa-bolt"></i> অ্যাকশন</div>
        <div class="cat-chip" onclick="filterCat(this)"><i class="fa-solid fa-clapperboard"></i> বলিউড</div>
    </div>

    <!-- Pagination Numbers -->
    <div class="pagination-bar">
        <div class="page-num active" onclick="changePage(this)">1</div>
        <div class="page-num" onclick="changePage(this)">2</div>
        <div class="page-num" onclick="changePage(this)">3</div>
        <div class="page-num" onclick="changePage(this)">4</div>
        <div class="page-num" onclick="changePage(this)">5</div>
        <div class="page-num" onclick="changePage(this)">6</div>
        <div class="page-num" onclick="changePage(this)">7</div>
        <div class="page-num" onclick="changePage(this)">8</div>
        <div class="page-num" onclick="changePage(this)">9</div>
        <div class="page-num" onclick="changePage(this)">10</div>
    </div>

    <!-- Video Feed Section -->
    <div class="section-header">
        <div class="section-title">
            <i class="fa-solid fa-fire-flame-curved" style="color: #ff6b00;"></i>
            ট্রেন্ডিং ভিডিও - সবার সেরা
        </div>
    </div>

    <!-- Video Cards Container -->
    <div class="video-grid" id="videoGrid">
        <!-- Card 1 -->
        <div class="video-card">
            <div class="thumb-wrapper" onclick="openVideoModal('https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4')">
                <div class="video-badge">#1</div>
                <div class="play-overlay"><i class="fa-solid fa-play"></i></div>
                <div class="thumb-grid">
                    <img src="https://picsum.photos/300/300?random=1" alt="thumb">
                    <img src="https://picsum.photos/300/300?random=2" alt="thumb">
                    <img src="https://picsum.photos/300/300?random=3" alt="thumb">
                    <img src="https://picsum.photos/300/300?random=4" alt="thumb">
                </div>
            </div>
            <div class="card-actions">
                <button class="btn-action btn-play" onclick="openVideoModal('https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4')">
                    <i class="fa-solid fa-play"></i> প্লে
                </button>
                <button class="btn-action btn-download" onclick="handleAdClick('monetag')">
                    <i class="fa-solid fa-download"></i> ডাউনলোড
                </button>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="video-card">
            <div class="thumb-wrapper" onclick="openVideoModal('https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4')">
                <div class="video-badge">#2</div>
                <div class="play-overlay"><i class="fa-solid fa-play"></i></div>
                <div class="thumb-grid">
                    <img src="https://picsum.photos/300/300?random=5" alt="thumb">
                    <img src="https://picsum.photos/300/300?random=6" alt="thumb">
                    <img src="https://picsum.photos/300/300?random=7" alt="thumb">
                    <img src="https://picsum.photos/300/300?random=8" alt="thumb">
                </div>
            </div>
            <div class="card-actions">
                <button class="btn-action btn-play" onclick="openVideoModal('https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4')">
                    <i class="fa-solid fa-play"></i> প্লে
                </button>
                <button class="btn-action btn-download" onclick="handleAdClick('monetag')">
                    <i class="fa-solid fa-download"></i> ডাউনলোড
                </button>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="video-card">
            <div class="thumb-wrapper" onclick="openVideoModal('https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4')">
                <div class="video-badge">#3</div>
                <div class="play-overlay"><i class="fa-solid fa-play"></i></div>
                <div class="thumb-grid">
                    <img src="https://picsum.photos/300/300?random=9" alt="thumb">
                    <img src="https://picsum.photos/300/300?random=10" alt="thumb">
                    <img src="https://picsum.photos/300/300?random=11" alt="thumb">
                    <img src="https://picsum.photos/300/300?random=12" alt="thumb">
                </div>
            </div>
            <div class="card-actions">
                <button class="btn-action btn-play" onclick="openVideoModal('https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4')">
                    <i class="fa-solid fa-play"></i> প্লে
                </button>
                <button class="btn-action btn-download" onclick="handleAdClick('adsterra')">
                    <i class="fa-solid fa-download"></i> ডাউনলোড
                </button>
            </div>
        </div>
    </div>

    <!-- Floating Join Button -->
    <a href="https://t.me/ViralMovieHubBot" target="_blank" class="floating-join-btn">
        <i class="fa-paper-plane fa-brands"></i> ✨ জয়েন করুন
    </a>

    <!-- Video Player Modal -->
    <div id="videoModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal()">&times;</span>
            <div class="video-container">
                <video id="mainPlayer" controls style="width: 100%; height: 100%;">
                    <source src="" type="video/mp4">
                    আপনার ব্রাউজার ভিডিও সাপোর্ট করে না।
                </video>
            </div>
            <div style="padding: 15px; text-align: center;">
                <button class="btn-action btn-play" style="width: 100%; margin-top: 5px;" onclick="handleAdClick('monetag')">
                    <i class="fa-solid fa-bolt"></i> HD কোয়ালিটি ভিডিও আনলক করুন
                </button>
            </div>
        </div>
    </div>

    <!-- Custom Script -->
    <script>
        // Direct Ad Links
        const MONETAG_LINK = "https://omg10.com/4/11914917";
        const ADSTERRA_LINK = "https://www.profitableratecpmnetwork.com/c096fxkh3?key=f9977391ed793a6bb843655c43eb6c16";

        // Initialize Telegram WebApp
        let tg = window.Telegram ? window.Telegram.WebApp : null;
        if (tg) {
            tg.expand();
            tg.enableClosingConfirmation();
        }

        // Helper to Trigger Ad Opening
        function handleAdClick(provider = 'adsterra') {
            const url = provider === 'monetag' ? MONETAG_LINK : ADSTERRA_LINK;
            showToast();
            
            // Open via Telegram WebApp SDK if supported, or window.open
            if (tg && tg.openLink) {
                tg.openLink(url);
            } else {
                window.open(url, '_blank');
            }
        }

        function showToast() {
            const toast = document.getElementById('toast');
            toast.style.display = 'block';
            setTimeout(() => {
                toast.style.display = 'none';
            }, 2500);
        }

        // Open Video Modal with Ad Interstitial
        function openVideoModal(videoSrc) {
            // First trigger Adsterra or Monetag
            handleAdClick('adsterra');

            // Then play video
            const modal = document.getElementById('videoModal');
            const player = document.getElementById('mainPlayer');
            player.src = videoSrc;
            modal.style.display = 'flex';
            player.play();
        }

        function closeModal() {
            const modal = document.getElementById('videoModal');
            const player = document.getElementById('mainPlayer');
            player.pause();
            modal.style.display = 'none';
        }

        function filterCat(element) {
            document.querySelectorAll('.cat-chip').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
            handleAdClick(Math.random() > 0.5 ? 'monetag' : 'adsterra');
        }

        function changePage(element) {
            document.querySelectorAll('.page-num').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
            handleAdClick('adsterra');
        }
    </script>
</body>
</html>
